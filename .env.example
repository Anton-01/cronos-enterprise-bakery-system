# Copy to .env (or export in your shell) and fill in real values.
# Never commit real secrets — this file must only ever contain placeholders.
# Also used by `docker compose watch` (docker-compose.yml loads this file via env_file).
#
# Already have a keys.properties file (the qa/prod secrets mechanism, see
# KeysPropertiesEnvironmentPostProcessor and keys.properties.example)? You don't need to duplicate
# DB_URL/DB_USERNAME/DB_PASSWORD/MAIL_PASSWORD/JWT_SECRET here — leave them unset below, set
# CRONOS_KEYS_FILE_HOST to that file's path, and run docker-compose.keys-file.yml as an extra -f
# overlay (see that file's header). The five vars below are the fallback for a first run with no
# keys.properties file yet.

# Neon (serverless Postgres) connection string. Must include sslmode=require. For plain local
# Postgres instead of Neon, swap the host/port/sslmode accordingly.
DB_URL=jdbc:postgresql://ep-example-123456.us-east-2.aws.neon.tech/cronos_bakery_system_nisnky?sslmode=require
DB_USERNAME=cronos_admin_user_bakery-system
DB_PASSWORD=changeme

# Unused when running `docker compose watch` (dev profile routes mail to the Mailpit container
# instead) — only needed for local runs against the real SendGrid SMTP config in application.yml.
MAIL_PASSWORD=changeme

JWT_SECRET=changeme-generate-a-256-bit-base64-secret

# Optional: Grafana local admin password (docker-compose.yml), defaults to "admin" if unset.
GRAFANA_ADMIN_PASSWORD=changeme

# Optional: only used with `-f docker-compose.keys-file.yml` (see that file). Path on YOUR machine
# (not inside the container) to an existing keys.properties. Leave unset if you're using the plain
# DB_URL/DB_USERNAME/DB_PASSWORD/MAIL_PASSWORD/JWT_SECRET vars above instead.
# CRONOS_KEYS_FILE_HOST=/Users/anton/Codification-back-files/pkt-k/scts/keys.properties
